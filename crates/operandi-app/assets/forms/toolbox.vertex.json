      "tooltip": "New Vertex... · vert.new{binding}"
    },
    {
      "command": "Make",
      "label": "Make Polygon",
      "tooltip": "Make Polygon · poly.make{binding}"
    },
    {
      "command": "Show Vertices",
      "look": "check",
