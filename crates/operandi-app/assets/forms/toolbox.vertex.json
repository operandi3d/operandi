{
  "version": 1,
  "id": "toolbox.vertex",
  "label": "Vertex",
  "exported": true,
  "controls": [
    {
      "divider": "Vertex Tools",
      "id": "vertex-tools"
    },
    {
      "command": "Create"
    },
    {
      "command": "Vertex Bevel"
    },
    {
      "command": "Vertex Extrude"
    },
    {
      "command": "Merge Tool"
    },
    {
      "command": "Weld",
