      "tooltip": "Align... · vert.align{binding}"
    },
    {
      "command": "Vertex Merge",
      "label": "Merge...",
      "tooltip": "Merge... · vert.merge{binding}"
    },
    {
      "command": "Vertex Join",
      "label": "Join...",
      "tooltip": "Join... · vert.join{binding}"
    },
    {
      "command": "Vertex Join Averaged",
      "label": "Join Averaged",
      "tooltip": "Join Averaged · vert.join average:true{binding}"
    },
    {
      "command": "Vertex Collapse",
      "label": "Collapse",
