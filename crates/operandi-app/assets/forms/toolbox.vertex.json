    },
    {
      "command": "Split",
      "label": "Split Polygon",
      "tooltip": "Split Polygon · poly.split{binding}"
    },
    {
      "command": "Vertex Set Position",
      "label": "Set Position...",
      "tooltip": "Set Position... · vert.set{binding}"
    },
    {
      "command": "Vertex Align",
