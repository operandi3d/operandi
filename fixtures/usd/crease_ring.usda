#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "Operandi regression fixture (written by hand): a Sub-D ring whose crease chain runs back from its last point to its first, as Blender writes a creased loop, under an Xform with an unapplied Z scale, like the pieces of a lathed chess set."
)

def Xform "root"
{
    def Xform "Piece"
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 0.005)
        double3 xformOp:translate = (0.25, 0.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Mesh "Shape"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 1, 5, 4, 1, 2, 6, 5, 2, 3, 7, 6, 3, 0, 4, 7, 4, 5, 6, 7]
            point3f[] points = [(-1, -1, 0), (1, -1, 0), (1, 1, 0), (-1, 1, 0), (-1, -1, 10), (1, -1, 10), (1, 1, 10), (-1, 1, 10)]
            int[] creaseIndices = [0, 1, 1, 2, 2, 3, 3, 0, 7, 4, 4, 5, 5, 6, 6, 7, 1, 0]
            int[] creaseLengths = [2, 2, 2, 2, 2, 2, 2, 2, 2]
            float[] creaseSharpnesses = [2, 2, 2, 2, 5, 5, 5, 5, 4]
            uniform token subdivisionScheme = "catmullClark"
        }
    }
}
