{
    int[] curveVertexCounts = [4]
    int[] order = [3]
    double[] knots = [0, 0, 0, 1, 2, 2, 2]
    double[] pointWeights = [1, 0.7, 0.7, 1]
    point3f[] points = [(0, 0, 6), (1, 1, 6), (2, 1, 6), (3, 0, 6)]
}
