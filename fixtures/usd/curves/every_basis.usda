{
    int[] curveVertexCounts = [5]
    int[] order = [4]
    double[] knots = [0, 0, 0, 0, 1, 2, 2, 2, 2]
    point3f[] points = [(0, 0, 5), (1, 1, 5), (2, 0, 5), (3, 1, 5), (4, 0, 5)]
