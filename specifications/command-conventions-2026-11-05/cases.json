  {
   "id": "CV01",
   "description": "Named arguments (axis:y value:0.5 \u2026)",
   "steps": [
    {
     "typed": "SETPOS axis:y value:0.5 workPlane:false worldSpace:false",
     "result": "ok"
    }
   ],
   "expected": {
    "points_after": [
     [
      -0.5,
      0.5,
      0.0
     ],
     [
      0.5,
      0.5,
      0.0
     ],
     [
