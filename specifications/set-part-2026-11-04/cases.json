[
  {"id": "SP-C01", "description": "Selected polygons get the part, others keep theirs",
   "input": {"mesh": "two quads side by side, q0 part=Lid, q1 part=Body, both material=Red", "mode": "polygon", "selected": ["q0"]},
   "settings": {"name": "Spout"},
   "expected": {"q0": {"part": "Spout", "material": "Red"}, "q1": {"part": "Body", "material": "Red"}, "undo_steps": 1}},
  {"id": "SP-C02", "description": "Nothing selected tags every polygon of the active mesh (provisional, SP-Q01)",
   "input": {"mesh": "two quads, no parts", "mode": "polygon", "selected": []},
   "settings": {"name": "Body"},
   "expected": {"q0": {"part": "Body"}, "q1": {"part": "Body"}, "undo_steps": 1}},
  {"id": "SP-C03", "description": "Two active meshes, nothing selected: both tagged in one step",
   "input": {"meshes": ["A: one quad", "B: one quad"], "active": ["A", "B"], "mode": "polygon", "selected": []},
   "settings": {"name": "Shell"},
   "expected": {"A.q0": {"part": "Shell"}, "B.q0": {"part": "Shell"}, "undo_steps": 1}},
  {"id": "SP-C04", "description": "Cancel changes nothing",
   "input": {"mesh": "two quads, q0 part=Lid", "mode": "polygon", "selected": ["q0"]},
   "settings": {"name": "Other", "action": "cancel"},
   "expected": {"q0": {"part": "Lid"}, "undo_steps": 0}},
  {"id": "SP-C05", "description": "Re-applying the same name is a no-op",
   "input": {"mesh": "one quad part=Lid", "mode": "polygon", "selected": ["q0"]},
   "settings": {"name": "Lid"},
   "expected": {"q0": {"part": "Lid"}, "undo_steps": 0}},
  {"id": "SP-C06", "description": "Dropdown lists parts from every mesh, once each",
   "input": {"meshes": ["A: q0 part=Lid, q1 part=Body", "B: q0 part=Lid"]},
   "settings": {"open_dialog": true},
   "expected": {"dropdown": ["Body", "Lid"]}},
  {"id": "SP-C07", "description": "Dialog opens with the Default Part preference",
   "input": {"preference_default_part": "Panel", "mesh": "one quad part=Lid", "selected": ["q0"]},
   "settings": {"open_dialog": true},
   "expected": {"name_field": "Panel"}},
  {"id": "SP-C08", "description": "Set Part leaves Selection Sets and Smoothing Groups alone",
   "input": {"mesh": "one quad, sets=[Top, Front], smoothing=A, part=Lid", "selected": ["q0"]},
   "settings": {"name": "Cap"},
   "expected": {"q0": {"part": "Cap", "sets": ["Top", "Front"], "smoothing": "A"}}}
]
